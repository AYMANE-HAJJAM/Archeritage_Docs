generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum StorageProvider {
  CLOUDINARY
  BACKBLAZE_B2
}

enum AccountStatus {
  INVITED
  ACTIVE
  DISABLED
}

/// Optional access filter for sensitive documents.
enum Confidentialite {
  PROJET
  CONFIDENTIEL
}

model User {
  id           String        @id @default(cuid())
  name         String
  firstName    String        @default("")
  lastName     String        @default("")
  email        String        @unique
  passwordHash String?
  role         Role          @default(USER)
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  files                File[]
  sessions             Session[]
  memberships          ProjectMember[]
  invitations          InvitationToken[]
  auditLogs            AuditLog[]     @relation("AuditActor")
  createdSectionGroups SectionGroup[] @relation("SectionGroupCreator")
  createdSections      Section[]      @relation("SectionCreator")
  createdFolders       Folder[]       @relation("FolderCreator")
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model InvitationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId])
}

/// Platform / container (e.g. Safi Patrimoine). Identity: `code` only.
model Territoire {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projects    Project[]
}

model Project {
  id           String         @id @default(cuid())
  name         String
  slug         String         @unique
  description  String?
  territoireId String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  territoire   Territoire?    @relation(fields: [territoireId], references: [id], onDelete: Restrict)
  members      ProjectMember[]
  parts        Part[]
  groups       SectionGroup[]

  @@index([territoireId])
  @@index([isActive])
}

model ProjectMember {
  id                 String   @id @default(cuid())
  userId             String
  projectId          String
  canView            Boolean  @default(false)
  canUpload          Boolean  @default(false)
  canDownload        Boolean  @default(false)
  canDeleteDocuments Boolean  @default(false)
  canManageStructure Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
  @@index([userId])
}

/// Optional subdivision of a project.
model Part {
  id        String         @id @default(cuid())
  projectId String
  name      String
  slug      String
  sortOrder Int            @default(0)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  groups    SectionGroup[]

  @@unique([projectId, slug])
  @@index([projectId, sortOrder])
  @@index([projectId, isActive])
}

model SectionGroup {
  id          String    @id @default(cuid())
  projectId   String
  /// When set, must belong to the same project (enforced in app + migration check).
  partId      String?
  name        String
  sortOrder   Int       @default(0)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  part        Part?     @relation(fields: [partId], references: [id], onDelete: Cascade)
  createdBy   User?     @relation("SectionGroupCreator", fields: [createdById], references: [id], onDelete: SetNull)
  sections    Section[]

  @@index([projectId, sortOrder])
  @@index([partId])
  @@index([createdById])
}

model Section {
  id        String       @id @default(cuid())
  groupId   String
  name      String
  /// Optional display code (e.g. 01.1). Not a relational identity.
  code      String?
  sortOrder Int          @default(0)
  isActive    Boolean      @default(true)
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  group       SectionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy   User?        @relation("SectionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  folders     Folder[]
  files       File[]

  @@index([groupId, sortOrder])
  @@index([groupId, isActive])
  @@index([createdById])
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  sectionId String
  parentId    String?
  sortOrder   Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  section     Section  @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  createdBy   User?    @relation("FolderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  parent    Folder?  @relation("FolderTree", fields: [parentId, sectionId], references: [id, sectionId], onDelete: Restrict, onUpdate: Restrict)
  children  Folder[] @relation("FolderTree")
  files     File[]

  @@unique([id, sectionId])
  @@index([sectionId, parentId])
  @@index([parentId])
  @@index([createdById])
}

model File {
  id              String          @id @default(cuid())
  originalName    String
  displayName     String
  extension       String
  mimeType        String
  size            Int
  storageProvider StorageProvider
  storageKey      String          @unique
  storageVersion  String?
  sourceHash      String?         @unique
  sectionId       String
  folderId        String?
  uploadedById    String
  confidentialite Confidentialite @default(PROJET)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  section         Section         @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  folder          Folder?         @relation(fields: [folderId, sectionId], references: [id, sectionId], onDelete: Restrict, onUpdate: Restrict)
  uploadedBy      User            @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([sectionId, folderId])
  @@index([folderId])
  @@index([uploadedById])
  @@index([sectionId, createdAt])
}
