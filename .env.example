# Local: no SSL required. Neon/hosted: use sslmode=verify-full (not require) to avoid pg SSL warnings.
DATABASE_URL="postgresql://archeritage:change-me@localhost:5432/archeritage?schema=public"
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Do not reuse this placeholder; the application deliberately rejects it.
AUTH_SECRET="replace-with-a-generated-64-character-hex-secret"
APP_URL="http://localhost:3000"
# Optional SMTP — when unset, invitations still work (ADMIN copies the link).
# Requires the `nodemailer` package (installed with the app).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="0"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ARCHERITAGE Docs <noreply@archeritage.local>"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
B2_ENDPOINT="https://s3.eu-central-003.backblazeb2.com"
B2_REGION="eu-central-003"
B2_BUCKET_NAME=""
B2_KEY_ID=""
B2_APPLICATION_KEY=""
MAX_UPLOAD_MB="25"
# Development seed only; set all three explicitly in production.
SEED_ADMIN_EMAIL="admin@archeritage.local"
SEED_ADMIN_PASSWORD="ChangeMe-Local-Only!2026"
SEED_ADMIN_NAME="Administrateur"
